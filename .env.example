# Rename this file to .env and fill in the values

# Required for Google Search API
GOOGLE_API_KEY=

# Required for SQLAlchemy database connection
# For Docker Compose, DATABASE_URL is injected automatically from the Postgres service.
# Set DATABASE_URL manually only when running outside Docker Compose.
DATABASE_URL=
POSTGRES_DB=sheep_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_EMAIL=demo@sheep.local
DEFAULT_USER_NAME=Sheep Demo User

# Optional Flask configuration
LOG_LEVEL=INFO
LOG_ENABLE_FILE=true
LOG_DIR=logs

# Optional: Set to 'development' for development environment, or 'production' for production environment
FLASK_ENV=
# Optional: Set to 'true' to enable Flask debug mode, or 'false' to disable it
FLASK_DEBUG=
# Optional: Number of messages to trigger summary generation (default: 20)
SUMMARY_TRIGGER_COUNT=
# Optional: Number of recent messages to keep in the conversation history (default: 10)
KEEP_RECENT_COUNT=

# Redis 
REDIS_URL=
REDIS_MAX_CONNECTIONS=35

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
FLOWER_BROKER_API=http://guest:guest@rabbitmq:15672/api/

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_BROKER_POOL_LIMIT=10
CELERY_TASK_TRACK_STARTED=
CELERY_RESULT_EXPIRES=
CELERY_TASK_SERIALIZER=
CELERY_RESULT_SERIALIZER=
CELERY_TIMEZONE=
CELERY_ENABLE_UTC=
