# Rename this file to .env and fill in the values

# Required for Google Search API
GOOGLE_API_KEY=

# Required for SQLAlchemy database connection
DATABASE_URL=

# Optional Flask configuration

# Optional: Set to 'development' for development environment, or 'production' for production environment
FLASK_ENV=
# Optional: Set to 'true' to enable Flask debug mode, or 'false' to disable it
FLASK_DEBUG=
# Optional: Number of messages to trigger summary generation (default: 20)
SUMMARY_TRIGGER_COUNT=
# Optional: Number of recent messages to keep in the conversation history (default: 10)
KEEP_RECENT_COUNT=

# Redis 
REDIS_URL=

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TRACK_STARTED=
CELERY_RESULT_EXPIRES=
CELERY_TASK_SERIALIZER=
CELERY_RESULT_SERIALIZER=
CELERY_TIMEZONE=
CELERY_ENABLE_UTC=